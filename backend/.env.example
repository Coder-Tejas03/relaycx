# RelayCX Backend Environment Configuration Template
# Copy this file to .env for local overrides or production deployment

# Local SQLite Database (Default for development)
DATABASE_URL=sqlite:///./relaycx.db

# Turso / libSQL Database (Used in production deployment - Phase 5)
TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
